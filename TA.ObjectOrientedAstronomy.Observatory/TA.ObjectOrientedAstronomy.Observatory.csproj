<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net48</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
    <Title>Observatory Utilities</Title>
    <Authors>Tim Long, Timtek Systems Limited</Authors>
    <Company>Timtek Systems Limited</Company>
    <Product>Object Oriented Astronomy</Product>
    <Description>Object-oriented observatory utilities</Description>
    <Copyright>Copyright © 2016-2023 Tim Long and Timtek Systems Limited</Copyright>
    <PackageIcon>TA.OOA-256x256.png</PackageIcon>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>Prerelease - interfaces subject to change</PackageReleaseNotes>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageProjectUrl>https://github.com/Tigra-Astronomy/TA.ObjectOrientedAstronomy</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Tigra-Astronomy/TA.ObjectOrientedAstronomy</RepositoryUrl>
    <PackageTags>Astronomy;Observatory;Timtek</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
</PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SemanticQuantities\Timtek.SemanticQuantities.csproj" />
  </ItemGroup>
</Project>
